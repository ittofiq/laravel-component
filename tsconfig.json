{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "@/*": ["./resources/js/*"],
            "*": ["./*"]
        }
    },
    "include": ["resources/js/**/*.ts"],
    "exclude": ["node_modules", "vendor"]
}